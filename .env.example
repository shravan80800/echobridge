# EchoBridge — Environment Variables Template (.env.example)
# Copy this file to .env.local for local development and configure these keys in Vercel Project Settings.
# NEVER commit your actual .env.local keys to Git.

# 1. Google Gemini API (Used for Retrieve-Only Generation, Semantic Entailment Judge & 768-dim Embeddings)
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 2. Supabase PostgreSQL + pgvector (Primary Relational & Vector Store)
# Note: If left blank in local/preview environments, EchoBridge automatically activates
# the deterministic CampusConnect Seed Fallback Store so judges can test all 8 traps with zero config.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# 3. Application & Security Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_DEMO_PROJECT=CampusConnect
FRESHNESS_THRESHOLD_DAYS=180
SESSION_SECRET=replace_with_a_32_character_random_secret_string
